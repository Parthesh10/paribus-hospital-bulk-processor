# Copy to .env to override defaults locally. Every variable is optional.
UPSTREAM_BASE_URL=https://hospital-directory.onrender.com
UPSTREAM_MAX_CONCURRENCY=20
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_READ_TIMEOUT=30
UPSTREAM_COLD_START_TIMEOUT=90
UPSTREAM_WARM_TTL_SECONDS=600
UPSTREAM_WARM_ON_STARTUP=true
UPSTREAM_MAX_ATTEMPTS=4
UPSTREAM_BACKOFF_BASE=0.5
UPSTREAM_BACKOFF_MAX=8
MAX_CSV_ROWS=20
MAX_UPLOAD_BYTES=262144
MAX_STORED_BATCHES=1000
LOG_LEVEL=INFO
LOG_FORMAT=text
SHUTDOWN_GRACE_SECONDS=20
